<?xml version="1.0" encoding="utf-8"?>
    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/Background"
        tools:context=".SignUpActivity">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Header Logo Container -->
            <LinearLayout
                android:id="@+id/logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_centerHorizontal="true">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/holo_blue_dark"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_agenda" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expense Flow"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/Primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Begin your journey to financial clarity."
                    android:textSize="13sp"
                    android:textColor="@color/TextColor"
                    android:layout_marginTop="6dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Main Form Containment Card -->
            <LinearLayout
                android:id="@+id/form_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/logo_container"
                android:layout_marginTop="20dp"
                android:background="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/TextColor"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/signup_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Enter your full name"
                    android:padding="10dp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="12dp" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/TextColor"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/signup_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="name@company.com"
                    android:padding="10dp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="12dp" />

                <!-- Phone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/TextColor"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/signup_phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="0700000000"
                    android:padding="10dp"
                    android:inputType="phone"
                    android:layout_marginBottom="12dp" />

                <!-- PIN Row layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:orientation="vertical"
                        android:layout_marginEnd="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Security Password"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/TextColor"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/signup_password"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/editbox_background_normal"
                            android:hint="******"
                            android:padding="10dp"
                            android:inputType="textPassword"
                            android:password="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:orientation="vertical"
                        android:layout_marginStart="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confirm Password"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/TextColor"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/signup_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/editbox_background_normal"
                            android:hint="******"
                            android:padding="10dp"
                            android:inputType="textPassword"
                            android:password="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Acceptance layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp"
                    android:gravity="top">

                    <CheckBox
                        android:id="@+id/signup_terms_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:text="I've read and agreed to the Terms of Service and Privacy Policy."
                        android:textSize="12sp"
                        android:textColor="@color/TextColor"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/signup_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sign Up"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/Primary" />

            </LinearLayout>

            <!-- Redirect to login link footer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/form_card"
                android:layout_marginTop="24dp"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textSize="14sp"
                    android:textColor="#454652" />

                <TextView
                    android:id="@+id/login_redirect_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:textSize="14sp"
                    android:textColor="#000666"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </RelativeLayout>
    </ScrollView>
